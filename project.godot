; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Library of Babel"
run/main_scene="res://Scenes/UI/main.tscn"
config/features=PackedStringArray("4.3", "C#", "GL Compatibility")
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/image="res://Assets/icon_transparent.png"
boot_splash/fullsize=false
config/icon="res://icon.svg"

[autoload]

GlobalValues="*res://Scripts/global_values.gd"
BabelMath="*res://Scripts/babel_math.cs"
Themes="*res://Scripts/themes.gd"
SaveManager="*res://Scripts/save_manager.gd"
GameOptions="*res://Scripts/game_options.gd"
AudioManager="*res://Scenes/audio_manager.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="The Library of Babel"

[editor_plugins]

enabled=PackedStringArray("res://addons/filesystem_drawer/plugin.cfg")

[gui]

theme/custom="res://Assets/Themes/light_theme.tres"
theme/default_font_multichannel_signed_distance_field=true

[input]

change_theme={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":84,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
toggle_fullscreen={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":true,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[shader_globals]

global_secondary_color={
"type": "color",
"value": Color(0, 0, 0, 1)
}
global_bg_color={
"type": "color",
"value": Color(1, 1, 1, 1)
}
global_text_color={
"type": "color",
"value": Color(0, 0, 0, 1)
}
